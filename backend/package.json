{
  "name": "ai-digital-twin-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js + Express backend for the AI Digital Twin & What-If Simulation Platform",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:build-watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "dev:run-watch": "node --watch dist/server.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seed.ts",
    "seed:build": "node dist/scripts/seed.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "kafkajs": "^2.2.4",
    "mongoose": "^9.10.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/supertest": "^6.0.2",
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^11.2.1",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^5.0.0"
  }
}
