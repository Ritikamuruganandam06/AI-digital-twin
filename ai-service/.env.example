# Only the variables app/config.py actually reads as of the current phase.

ENV=development
PORT=8000

BACKEND_BASE_URL=http://localhost:4000

# Phase 9 (Groq + Llama integration). LLM_MODEL is deliberately
# configurable rather than hardcoded (docs/architecture.md §9) -- Groq's
# supported model names change, so this is a default, not a dependency.
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
# Never commit a real key. Get one from https://console.groq.com
GROQ_API_KEY=change-me-in-local-env

# Phase 10 (Agent Tool Calling). Hard caps on the agent loop
# (app/agent/loop.py) -- docs/architecture.md §8 step 6: "repeat until
# Llama produces a final answer or an iteration/timeout limit is hit."
AGENT_MAX_ITERATIONS=6
AGENT_TOOL_TIMEOUT_MS=10000

# Phase 11 (Qdrant + Embedding Model). Requires a real Qdrant instance
# reachable at QDRANT_URL (binary or local server -- see the root
# README's prerequisites; no Docker). EMBEDDING_MODEL's default
# (BAAI/bge-small-en-v1.5) is justified in app/rag/embedding.py.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_base
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

LOG_LEVEL=info
